<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".studylist.backgroundwork.coroutine.CoroutineFlowFragment">


    <LinearLayout
        android:id="@+id/ll_coroutine_flow_producer"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:weightSum="10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.333"
        tools:background="@android:color/holo_blue_light">

        <TextView
            android:id="@+id/tv_coroutine_flow_producer_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:gravity="center"
            android:text="producer"
            android:textColor="@color/black"
            tools:background="@android:color/holo_blue_bright" />

        <TextView
            android:id="@+id/tv_coroutine_flow_producer_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:textColor="@color/black"
            tools:background="@android:color/holo_blue_dark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_coroutine_flow_intermediary"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_coroutine_flow_producer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.333"
        tools:background="@android:color/holo_green_light">

        <TextView
            android:id="@+id/tv_coroutine_flow_Intermediary_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:gravity="center"
            android:text="Intermediary"
            android:textColor="@color/black"
            tools:background="@android:color/holo_blue_bright" />

        <TextView
            android:id="@+id/tv_coroutine_flow_Intermediary_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:textColor="@color/black"
            tools:background="@android:color/holo_blue_dark" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_coroutine_flow_consumer"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_coroutine_flow_intermediary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.333"
        tools:background="@android:color/holo_red_light">

        <TextView
            android:id="@+id/tv_coroutine_flow_consumer_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:text="Consumer"
            android:gravity="center"
            android:textColor="@color/black"
            tools:background="@android:color/holo_blue_bright" />

        <TextView
            android:id="@+id/tv_coroutine_flow_consumer_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:textColor="@color/black"
            tools:background="@android:color/holo_blue_dark" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>